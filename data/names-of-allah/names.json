[
  {"number": 1,  "arabic": "ٱلرَّحْمَٰنُ",     "translit": "Ar-Rahman",    "meaning": "الرحيم بجميع خلقه", "short": "الذي رحمته وسعت كل شيء"},
  {"number": 2,  "arabic": "ٱلرَّحِيمُ",       "translit": "Ar-Raheem",    "meaning": "الرحيم بالمؤمنين", "short": "الذي يرحم المؤمنين رحمة خاصة"},
  {"number": 3,  "arabic": "ٱلْمَلِكُ",        "translit": "Al-Malik",     "meaning": "المالك لكل شيء", "short": "مالك الملك كله"},
  {"number": 4,  "arabic": "ٱلْقُدُّوسُ",      "translit": "Al-Quddus",    "meaning": "المنزه عن كل نقص", "short": "الطاهر المنزه عن العيوب"},
  {"number": 5,  "arabic": "ٱلسَّلَٰمُ",       "translit": "As-Salam",     "meaning": "السالم من كل عيب", "short": "ذي السلامة الكاملة"},
  {"number": 6,  "arabic": "ٱلْمُؤْمِنُ",      "translit": "Al-Mu'min",    "meaning": "المصدِّق بالحق", "short": "المُؤمِّن عباده أمنه"},
  {"number": 7,  "arabic": "ٱلْمُهَيْمِنُ",    "translit": "Al-Muhaymin",  "meaning": "الرقيب على كل شيء", "short": "المطلع على جميع الأشياء"},
  {"number": 8,  "arabic": "ٱلْعَزِيزُ",       "translit": "Al-Aziz",      "meaning": "القوي الذي لا يُغلب", "short": "القاهر فوق عباده"},
  {"number": 9,  "arabic": "ٱلْجَبَّارُ",      "translit": "Al-Jabbar",    "meaning": "الذي يجبر الكسر", "short": "الذي ينفذ أمره"},
  {"number": 10, "arabic": "ٱلْمُتَكَبِّرُ",   "translit": "Al-Mutakabbir","meaning": "العظيم المتنزه", "short": "المتعظم عما لا يليق"},
  {"number": 11, "arabic": "ٱلْخَٰلِقُ",       "translit": "Al-Khaliq",    "meaning": "موجد الأشياء", "short": "الذي خلق كل شيء"},
  {"number": 12, "arabic": "ٱلْبَارِئُ",       "translit": "Al-Bari'",     "meaning": "المنشئ من عدم", "short": "الذي أنشأ الأشياء"},
  {"number": 13, "arabic": "ٱلْمُصَوِّرُ",     "translit": "Al-Musawwir",  "meaning": "الذي صور المخلوقات", "short": "الذي شكّل كل شيء"},
  {"number": 14, "arabic": "ٱلْغَفَّارُ",      "translit": "Al-Ghaffar",   "meaning": "كثير المغفرة", "short": "الذي يستر الذنوب"},
  {"number": 15, "arabic": "ٱلْقَهَّارُ",      "translit": "Al-Qahhar",    "meaning": "القاهر فوق عباده", "short": "الغالب على كل شيء"},
  {"number": 16, "arabic": "ٱلْوَهَّابُ",      "translit": "Al-Wahhab",    "meaning": "كثير العطاء بلا مقابل", "short": "الذي يعطي بلا سؤال"},
  {"number": 17, "arabic": "ٱلرَّزَّاقُ",      "translit": "Ar-Razzaq",    "meaning": "المتكفل بالأرزاق", "short": "الذي يرزق جميع خلقه"},
  {"number": 18, "arabic": "ٱلْفَتَّاحُ",      "translit": "Al-Fattah",    "meaning": "الذي يفتح أبواب الرحمة", "short": "الذي يحكم بين عباده"},
  {"number": 19, "arabic": "ٱلْعَلِيمُ",       "translit": "Al-'Alim",     "meaning": "العليم بكل شيء", "short": "الذي أحاط علمه بكل شيء"},
  {"number": 20, "arabic": "ٱلْقَابِضُ",       "translit": "Al-Qabid",     "meaning": "الذي يقبض الأرزاق", "short": "الذي يضيق الرزق على من يشاء"},
  {"number": 21, "arabic": "ٱلْبَاسِطُ",       "translit": "Al-Basit",     "meaning": "الذي يبسط الرزق", "short": "الذي يوسع الرزق"},
  {"number": 22, "arabic": "ٱلْخَافِضُ",       "translit": "Al-Khafid",    "meaning": "الذي يخفض من يشاء", "short": "الذي يضع من يشاء"},
  {"number": 23, "arabic": "ٱلرَّافِعُ",       "translit": "Ar-Rafi'",     "meaning": "الذي يرفع من يشاء", "short": "الذي يرفع درجات من يشاء"},
  {"number": 24, "arabic": "ٱلْمُعِزُّ",       "translit": "Al-Mu'izz",    "meaning": "الذي يعز من يشاء", "short": "الذي يعطي العزة"},
  {"number": 25, "arabic": "ٱلْمُذِلُّ",       "translit": "Al-Mudhill",   "meaning": "الذي يذل من يشاء", "short": "الذي يهب الإذلال لمن يستحق"},
  {"number": 26, "arabic": "ٱلسَّمِيعُ",       "translit": "As-Sami'",     "meaning": "السامع لكل شيء", "short": "الذي يسمع جميع الأصوات"},
  {"number": 27, "arabic": "ٱلْبَصِيرُ",       "translit": "Al-Basir",     "meaning": "البصير بكل شيء", "short": "الذي يبصر كل شيء"},
  {"number": 28, "arabic": "ٱلْحَكَمُ",        "translit": "Al-Hakam",     "meaning": "الحاكم بين عباده", "short": "الذي يفصل بين الخلق"},
  {"number": 29, "arabic": "ٱلْعَدْلُ",        "translit": "Al-'Adl",      "meaning": "العادل في حكمه", "short": "الذي لا يجور"},
  {"number": 30, "arabic": "ٱللَّطِيفُ",       "translit": "Al-Latif",     "meaning": "الرفيق بعباده", "short": "الذي يرفق بهم"},
  {"number": 31, "arabic": "ٱلْخَبِيرُ",       "translit": "Al-Khabir",    "meaning": "العالم بحقائق الأمور", "short": "الذي يعلم البواطن"},
  {"number": 32, "arabic": "ٱلْحَلِيمُ",       "translit": "Al-Halim",     "meaning": "الذي لا يعجل بالعقوبة", "short": "الذي لا يستفزه عصيان العاصين"},
  {"number": 33, "arabic": "ٱلْعَظِيمُ",       "translit": "Al-'Azim",     "meaning": "ذو العظمة الكاملة", "short": "الذي له كل عظمة"},
  {"number": 34, "arabic": "ٱلْغَفُورُ",       "translit": "Al-Ghafur",    "meaning": "كثير المغفرة", "short": "الواسع المغفرة"},
  {"number": 35, "arabic": "ٱلشَّكُورُ",       "translit": "Ash-Shakur",   "meaning": "الذي يجزي على القليل بالكثير", "short": "الذي يشكر القليل"},
  {"number": 36, "arabic": "ٱلْعَلِيُّ",       "translit": "Al-'Ali",      "meaning": "الرفيع القدر", "short": "الذي علا على كل شيء"},
  {"number": 37, "arabic": "ٱلْكَبِيرُ",       "translit": "Al-Kabir",     "meaning": "الكبير المتعال", "short": "الذي كل شيء دونه"},
  {"number": 38, "arabic": "ٱلْحَفِيظُ",       "translit": "Al-Hafiz",     "meaning": "الحافظ لكل شيء", "short": "الذي يحفظ عباده"},
  {"number": 39, "arabic": "ٱلْمُقِيتُ",       "translit": "Al-Muqit",     "meaning": "المقتدر على كل شيء", "short": "المتكفل بالأقوات"},
  {"number": 40, "arabic": "ٱلْحَسِيبُ",       "translit": "Al-Hasib",     "meaning": "الكافي عباده", "short": "الذي يحاسب عباده"},
  {"number": 41, "arabic": "ٱلْجَلِيلُ",       "translit": "Al-Jalil",     "meaning": "ذو الجلال والعظمة", "short": "الذي يُجَلّ"},
  {"number": 42, "arabic": "ٱلْكَرِيمُ",       "translit": "Al-Karim",     "meaning": "كثير الخير", "short": "الذي يعطي بلا حساب"},
  {"number": 43, "arabic": "ٱلرَّقِيبُ",       "translit": "Ar-Raqib",     "meaning": "الحافظ المراقب", "short": "الذي يراقب عباده"},
  {"number": 44, "arabic": "ٱلْمُجِيبُ",       "translit": "Al-Mujib",     "meaning": "مجيب الدعاء", "short": "الذي يجيب المضطرين"},
  {"number": 45, "arabic": "ٱلْوَاسِعُ",       "translit": "Al-Wasi'",     "meaning": "الذي وسع كل شيء", "short": "الذي وسع رحمته"},
  {"number": 46, "arabic": "ٱلْحَكِيمُ",       "translit": "Al-Hakim",     "meaning": "الحكيم في أفعاله", "short": "الذي أحكم كل شيء"},
  {"number": 47, "arabic": "ٱلْوَدُودُ",       "translit": "Al-Wadud",     "meaning": "المحب لعباده", "short": "الذي يحب عباده المؤمنين"},
  {"number": 48, "arabic": "ٱلْمَجِيدُ",       "translit": "Al-Majid",     "meaning": "العظيم الشأن", "short": "الذي له المجد كله"},
  {"number": 49, "arabic": "ٱلْبَاعِثُ",       "translit": "Al-Ba'ith",    "meaning": "الذي يبعث الموتى", "short": "الذي يحيي الموتى"},
  {"number": 50, "arabic": "ٱلشَّهِيدُ",       "translit": "Ash-Shahid",   "meaning": "الشاهد على كل شيء", "short": "الذي لا يغيب عنه شيء"},
  {"number": 51, "arabic": "ٱلْحَقُّ",         "translit": "Al-Haqq",      "meaning": "الموجود الثابت", "short": "الذي هو حق في ذاته"},
  {"number": 52, "arabic": "ٱلْوَكِيلُ",       "translit": "Al-Wakil",     "meaning": "المتكفل بالأمور", "short": "الذي يُفوَّض إليه الأمر"},
  {"number": 53, "arabic": "ٱلْقَوِيُّ",       "translit": "Al-Qawiyy",    "meaning": "صاحب القوة الكاملة", "short": "الذي لا يُغلب"},
  {"number": 54, "arabic": "ٱلْمَتِينُ",       "translit": "Al-Matin",     "meaning": "الشديد القوي", "short": "الذي لا يلحقه ضعف"},
  {"number": 55, "arabic": "ٱلْوَلِيُّ",       "translit": "Al-Waliyy",    "meaning": "نصير المؤمنين", "short": "الذي يتولى عباده"},
  {"number": 56, "arabic": "ٱلْحَمِيدُ",       "translit": "Al-Hamid",     "meaning": "المستحمد بكل حال", "short": "المحمود على كل حال"},
  {"number": 57, "arabic": "ٱلْمُحْصِي",      "translit": "Al-Muhsi",     "meaning": "الذي أحصى كل شيء", "short": "الذي يعلم عدد كل شيء"},
  {"number": 58, "arabic": "ٱلْمُبْدِئُ",      "translit": "Al-Mubdi'",    "meaning": "الذي أنشأ الأشياء", "short": "الذي بدأ الخلق"},
  {"number": 59, "arabic": "ٱلْمُعِيدُ",       "translit": "Al-Mu'id",     "meaning": "الذي يعيد الخلق", "short": "الذي يبعث الموتى مرة أخرى"},
  {"number": 60, "arabic": "ٱلْمُحْيِي",      "translit": "Al-Muhyi",     "meaning": "الذي يحيي الموتى", "short": "خالق الحياة"},
  {"number": 61, "arabic": "ٱلْمُمِيتُ",       "translit": "Al-Mumit",     "meaning": "الذي يميت الأحياء", "short": "الذي يقبض الأرواح"},
  {"number": 62, "arabic": "ٱلْحَيُّ",         "translit": "Al-Hayy",      "meaning": "الباقي الذي لا يموت", "short": "الحي حياة كاملة"},
  {"number": 63, "arabic": "ٱلْقَيُّومُ",      "translit": "Al-Qayyum",    "meaning": "القائم بنفسه", "short": "القائم على كل شيء"},
  {"number": 64, "arabic": "ٱلْوَاجِدُ",       "translit": "Al-Wajid",     "meaning": "الذي لا يحتاج", "short": "الذي يَجِدُ كل ما يريد"},
  {"number": 65, "arabic": "ٱلْمَاجِدُ",       "translit": "Al-Majid",     "meaning": "ذو المجد والشرف", "short": "الذي علا قدره"},
  {"number": 66, "arabic": "ٱلْوَٰحِدُ",       "translit": "Al-Wahid",     "meaning": "الفرد في ذاته", "short": "الأحد الذي لا ثاني له"},
  {"number": 67, "arabic": "ٱلْأَحَدُ",        "translit": "Al-Ahad",      "meaning": "الواحد الذي لا يتجزأ", "short": "الذي لا شريك له"},
  {"number": 68, "arabic": "ٱلسَّمَدُ",        "translit": "As-Samad",     "meaning": "السيِّد الذي يُقصد", "short": "الذي يُفتقر إليه"},
  {"number": 69, "arabic": "ٱلْقَادِرُ",       "translit": "Al-Qadir",     "meaning": "ذو القدرة", "short": "القادر على كل شيء"},
  {"number": 70, "arabic": "ٱلْمُقْتَدِرُ",    "translit": "Al-Muqtadir",  "meaning": "ذو القدرة التامة", "short": "الذي يقدر على ما يشاء"},
  {"number": 71, "arabic": "ٱلْمُقَدِّمُ",     "translit": "Al-Muqaddim",  "meaning": "الذي يقدم الأشياء", "short": "الذي يقدم من يشاء"},
  {"number": 72, "arabic": "ٱلْمُؤَخِّرُ",     "translit": "Al-Mu'akhkhir","meaning": "الذي يؤخر الأشياء", "short": "الذي يؤخر من يشاء"},
  {"number": 73, "arabic": "ٱلْأَوَّلُ",       "translit": "Al-Awwal",     "meaning": "الذي ليس قبله شيء", "short": "الذي ابتدأ كل شيء"},
  {"number": 74, "arabic": "ٱلْآخِرُ",        "translit": "Al-Akhir",     "meaning": "الذي ليس بعده شيء", "short": "الباقي بعد فناء خلقه"},
  {"number": 75, "arabic": "ٱلظَّٰهِرُ",       "translit": "Az-Zahir",     "meaning": "الظاهر فوق كل شيء", "short": "الذي ظهر فوق كل شيء"},
  {"number": 76, "arabic": "ٱلْبَاطِنُ",       "translit": "Al-Batin",     "meaning": "المستتر عن الأبصار", "short": "الذي احتجب عن العيون"},
  {"number": 77, "arabic": "ٱلْوَالِي",       "translit": "Al-Wali",      "meaning": "المالك المتصرف", "short": "الذي يتولى أمر خلقه"},
  {"number": 78, "arabic": "ٱلْمُتَعَالِي",   "translit": "Al-Muta'ali",  "meaning": "المنزه عن صفات المخلوقين", "short": "الذي علا على كل شيء"},
  {"number": 79, "arabic": "ٱلْبَرُّ",         "translit": "Al-Barr",      "meaning": "كثير الخير والبر", "short": "العطوف على عباده"},
  {"number": 80, "arabic": "ٱلتَّوَّابُ",      "translit": "At-Tawwab",    "meaning": "الذي يقبل التوبة", "short": "الذي يرجع على عباده بالرحمة"},
  {"number": 81, "arabic": "ٱلْمُنْتَقِمُ",    "translit": "Al-Muntaqim",  "meaning": "الذي ينتقم من العصاة", "short": "الذي ي punishment المستحقين"},
  {"number": 82, "arabic": "ٱلْعَفُوُّ",       "translit": "Al-'Afuww",    "meaning": "كثير العفو", "short": "الذي يمحو الذنوب"},
  {"number": 83, "arabic": "ٱلرَّؤُوفُ",       "translit": "Ar-Ra'uf",     "meaning": "شديد الرحمة", "short": "الذي يرحم عباده رأفة خاصة"},
  {"number": 84, "arabic": "مَٰلِكُ ٱلْمُلْكِ","translit": "Malik-ul-Mulk","meaning": "المالك للملك كله", "short": "الذي يتصرف في الملك"},
  {"number": 85, "arabic": "ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ", "translit": "Dhul-Jalali wal-Ikram", "meaning": "صاحب العظمة والكرم", "short": "الذي يجمع الجلال والإكرام"},
  {"number": 86, "arabic": "ٱلْمُقْسِطُ",      "translit": "Al-Muqsit",    "meaning": "العادل في حكمه", "short": "الذي يقسط بين العباد"},
  {"number": 87, "arabic": "ٱلْجَامِعُ",       "translit": "Al-Jami'",     "meaning": "الذي يجمع الخلق", "short": "الذي يجمع الناس ليوم القيامة"},
  {"number": 88, "arabic": "ٱلْغَنِيُّ",       "translit": "Al-Ghaniyy",   "meaning": "الذي لا يحتاج", "short": "المستغني عن كل شيء"},
  {"number": 89, "arabic": "ٱلْمُغْنِي",      "translit": "Al-Mughni",    "meaning": "الذي يغني عباده", "short": "الذي يعطي الغنى"},
  {"number": 90, "arabic": "ٱلْمَانِعُ",       "translit": "Al-Mani'",     "meaning": "الذي يمنع من يشاء", "short": "الذي يحفظ عباده"},
  {"number": 91, "arabic": "ٱلضَّارُّ",        "translit": "Ad-Darr",      "meaning": "الذي يضر من يشاء بحكمته", "short": "الذي يبتلي عباده"},
  {"number": 92, "arabic": "ٱلنَّافِعُ",       "translit": "An-Nafi'",     "meaning": "الذي ينفع من يشاء", "short": "الذي ينفع عباده"},
  {"number": 93, "arabic": "ٱلنُّورُ",         "translit": "An-Nur",       "meaning": "نور السماوات والأرض", "short": "الذي نور قلوب المؤمنين"},
  {"number": 94, "arabic": "ٱلْهَادِي",       "translit": "Al-Hadi",      "meaning": "الذي يهدي عباده", "short": "الذي دل خلقه على الحق"},
  {"number": 95, "arabic": "ٱلْبَدِيعُ",       "translit": "Al-Badi'",     "meaning": "الذي أنشأ الأشياء بلا مثال", "short": "الذي أوجد الأشياء على غير مثال"},
  {"number": 96, "arabic": "ٱلْبَاقِي",       "translit": "Al-Baqi",      "meaning": "الدائم الوجود", "short": "الباقي بعد فناء خلقه"},
  {"number": 97, "arabic": "ٱلْوَارِثُ",       "translit": "Al-Warith",    "meaning": "الباقي بعد فناء الخلق", "short": "الذي يرث الأرض ومن عليها"},
  {"number": 98, "arabic": "ٱلرَّشِيدُ",       "translit": "Ar-Rashid",    "meaning": "الحسن الرشد", "short": "الذي يرشد عباده"},
  {"number": 99, "arabic": "ٱلصَّبُورُ",       "translit": "As-Sabur",     "meaning": "الذي لا يعجل بالعقوبة", "short": "الذي لا يحفظ عليهم سيئاتهم"}
]
